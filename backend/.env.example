# Holy Trial Backend Configuration
PROJECT_NAME="Holy Trial Judicial Backend"
VERSION="1.0.0"
API_V1_STR="/api/v1"

# Database: SQLite for local dev & testing, or PostgreSQL for production
# Example PostgreSQL: postgresql+psycopg2://user:password@localhost:5432/holytrial
DATABASE_URL="sqlite:///./holytrial.db"

# Allowed CORS Origins (JSON array format)
CORS_ORIGINS=["http://localhost:5173", "http://localhost:3000", "http://127.0.0.1:5173"]

# Adversarial Reasoning Engine
# Supported providers: 'local_heuristic' (default offline), 'external' (OpenAI / NVIDIA NIM), 'test'
REASONING_PROVIDER="local_heuristic"

# Required only if REASONING_PROVIDER="external"
REASONING_API_KEY=""
REASONING_MODEL_NAME="meta/llama-3.1-70b-instruct"
REASONING_BASE_URL="https://integrate.api.nvidia.com/v1"
REASONING_TIMEOUT_SECONDS=30.0

# Remote Evidence Search & Retrieval
TAVILY_API_KEY=""
